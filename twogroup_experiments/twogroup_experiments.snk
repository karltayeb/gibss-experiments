import sys
from pathlib import Path

import polars as pl

RESULTS_ROOT = "results"

from utils import fit_batch_method, simulate_batch, write_parquet
from plot_ready import build_sample_metadata
from experiments import loader
from manifest_cache import load_manifest_cached

MANIFEST = load_manifest_cached()
CONFIG = loader.load_config()
LIBRARY = CONFIG["library"]
SUPERCOLLECTIONS = sorted(CONFIG["supercollections"].keys())


wildcard_constraints:
    batch_hash=r"[0-9a-f]{64}",
    method_hash=r"[0-9a-f]{64}",
    reduction=r"[A-Za-z0-9_]+",
    analysis=r"[A-Za-z0-9_]+",
    args_name=r"[A-Za-z0-9_\-]+",
    supercollection=r"[A-Za-z0-9_\-\.]+",


def _all_analysis_targets():
    targets = []
    for sc in SUPERCOLLECTIONS:
        for analysis, args_name in loader.resolve_sc_analyses(CONFIG, sc):
            targets.append(
                f"{RESULTS_ROOT}/supercollections/{sc}/{analysis}/{args_name}.pdf"
            )
    return targets


def _all_analysis_names():
    """Union of all analysis names referenced by any supercollection."""
    seen = set()
    for sc in SUPERCOLLECTIONS:
        for analysis, _ in loader.resolve_sc_analyses(CONFIG, sc):
            seen.add(analysis)
    return sorted(seen)


# ---------------------------------------------------------------------------
# Generic simulate rule
# ---------------------------------------------------------------------------

rule simulate:
    output:
        simulations=f"{RESULTS_ROOT}/by_batch/{{batch_hash}}/simulations.parquet",
        sample_metadata=f"{RESULTS_ROOT}/by_batch/{{batch_hash}}/sample_metadata.parquet",
    input:
        code=lambda wc: loader.simulation_code_files(
            MANIFEST["batches"][wc.batch_hash]["coordinate"], LIBRARY
        ),
    run:
        b = MANIFEST["batches"][wildcards.batch_hash]
        spec = loader.resolve_simulation_from_coord(b["coordinate"])
        df = simulate_batch(spec, replicates=b["replicates"])
        write_parquet(df, output.simulations)
        write_parquet(build_sample_metadata(wildcards.batch_hash, df), output.sample_metadata)


# ---------------------------------------------------------------------------
# Generic fit rule
# ---------------------------------------------------------------------------

# CONSERVATIVE per-method SLURM walltime. A fit job runs ONE method over ALL reps in
# its batch, so runtime scales with the batch's replicate count. Per-rep minutes are
# biased high (worst design at its iteration cap, plus cluster-CPU + JIT margin) from
# the measured single-fit times: gIBSS/global-JJ L=10 ~2-23s, CAVI-cf L=10 2-9 min
# (up to ~23 min at max_iter=50 on the n=10000 binary design). The CAVI-cf L=10 arm is
# the only expensive one; everything else is minutes. Keyed on the method's
# offset_integration + L, so 018/017 (rpb=50) and 019 (rpb=10) both get right-sized jobs.
def _fit_resources(batch_hash, method_hash):
    kw = MANIFEST["methods"][method_hash].get("kwargs", {}) or {}
    nreps = len(MANIFEST["batches"][batch_hash]["replicates"])
    oi = kw.get("offset_integration")
    L = int(kw.get("L", 1) or 1)
    # per-rep minutes carry a ~2x margin over the measured single-fit times, so a
    # slower cluster CPU (or a fit that runs to its iteration cap) still finishes: a
    # killed job wastes all its work, an over-provisioned one just backfills.
    if oi == "cf" and L >= 10:
        per_rep, mem = 60, 16000     # CAVI-cf over-specified: the pole (~23 min/rep measured)
    elif L >= 10:
        per_rep, mem = 6, 8000       # gIBSS / global-JJ / local-JJ at L=10
    elif oi == "cf":
        per_rep, mem = 4, 8000       # CAVI-cf SER (no offset fold)
    else:
        per_rep, mem = 2, 6000       # L=1 exact / bound, cheap arms
    runtime = min(2100, int(per_rep * nreps) + 15)   # minutes; capped under caslake 36h
    return {"runtime": runtime, "mem_mb": mem}


rule fit:
    output:
        fits=f"{RESULTS_ROOT}/by_batch/{{batch_hash}}/fits/{{method_hash}}/fits.parquet",
    input:
        simulations=f"{RESULTS_ROOT}/by_batch/{{batch_hash}}/simulations.parquet",
        code=lambda wc: (
            loader.method_code_files(MANIFEST["methods"][wc.method_hash], LIBRARY)
            + loader.simulation_code_files(
                MANIFEST["batches"][wc.batch_hash]["coordinate"], LIBRARY
            )
        ),
    resources:
        runtime=lambda wc: _fit_resources(wc.batch_hash, wc.method_hash)["runtime"],
        mem_mb=lambda wc: _fit_resources(wc.batch_hash, wc.method_hash)["mem_mb"],
    run:
        b = MANIFEST["batches"][wildcards.batch_hash]
        spec = loader.resolve_simulation_from_coord(b["coordinate"])
        method_coord = MANIFEST["methods"][wildcards.method_hash]
        df = fit_batch_method(spec, method_coord=method_coord, replicates=b["replicates"])
        write_parquet(df, output.fits)


# ---------------------------------------------------------------------------
# Loop-generated reduce_<name> rules (one per reduction in LIBRARY)
# ---------------------------------------------------------------------------
# Wrapped in a function to capture the loop variable at definition time;
# Snakemake 9 defers script: path evaluation, so a bare for-loop would cause
# all rules to use the last iteration's value (closure bug).

def _make_reduce_rule(r):
    rule:
        name: f"reduce_{r}"
        output:
            f"{RESULTS_ROOT}/by_batch/{{batch_hash}}/fits/{{method_hash}}/reductions/{r}.parquet"
        input:
            fits=f"{RESULTS_ROOT}/by_batch/{{batch_hash}}/fits/{{method_hash}}/fits.parquet",
            sims=f"{RESULTS_ROOT}/by_batch/{{batch_hash}}/simulations.parquet",
            sample_md=f"{RESULTS_ROOT}/by_batch/{{batch_hash}}/sample_metadata.parquet",
        params:
            coordinate=lambda wc, _r=r: MANIFEST["batches"][wc.batch_hash]["coordinate"],
        script:
            f"reductions/{r}.py"

for _r in LIBRARY["reductions"]:
    _make_reduce_rule(_r)


# ---------------------------------------------------------------------------
# Loop-generated analyze_<analysis> rules (one per analysis referenced by SCs)
# ---------------------------------------------------------------------------
# Same closure-capture fix: wrap in a function so `a` and `family` are bound
# at definition time, not at execution time.
# Also passes analysis name via params so the script can read snakemake.params.analysis
# (the output path has `a` baked in, not as a wildcard).

def _make_analyze_rule(a):
    _family = loader.analysis_family(a)
    rule:
        name: f"analyze_{a}"
        output:
            f"{RESULTS_ROOT}/supercollections/{{supercollection}}/{a}/{{args_name}}.pdf"
        input:
            deps=lambda wc, _a=a: loader.analysis_inputs(
                CONFIG, MANIFEST, wc.supercollection, _a
            ),
        params:
            analysis=a,
        script:
            f"analyses/{_family}.py"

for _a in _all_analysis_names():
    _make_analyze_rule(_a)


# ---------------------------------------------------------------------------
# all_plots target
# ---------------------------------------------------------------------------

rule all_plots:
    input:
        _all_analysis_targets(),


# ---------------------------------------------------------------------------
# Per-supercollection aggregator: build every analysis PDF for one SC
#   uv run snakemake -s twogroup_experiments.snk -c8 \
#       results/supercollections/<sc>/.done
# ---------------------------------------------------------------------------

rule supercollection:
    input:
        lambda wc: [
            f"{RESULTS_ROOT}/supercollections/{wc.supercollection}/{analysis}/{args_name}.pdf"
            for analysis, args_name in loader.resolve_sc_analyses(CONFIG, wc.supercollection)
        ],
    output:
        touch(f"{RESULTS_ROOT}/supercollections/{{supercollection}}/.done"),
